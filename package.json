{
  "name": "@lynkomni/icons",
  "version": "1.2.0",
  "description": "LynkOmni brand system: logos, wordmark and emblem for web, React, Android, iOS and email, generated from one manifest.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/react/index.js",
  "types": "./dist/react/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "default": "./dist/brand/index.js"
    },
    "./brand.json": "./dist/brand.json",
    "./svg/*": "./dist/svg/*",
    "./web/*": "./dist/web/*",
    "./email/*": "./dist/email/*",
    "./android/*": "./dist/android/*",
    "./ios/*": "./dist/ios/*",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/react/*.d.ts",
      "default": "./dist/react/*.js"
    }
  },
  "files": [
    "dist",
    "brand",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LynkOmni/lynkomni-icons.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "raster": "node scripts/raster.mjs",
    "check": "node scripts/check.mjs",
    "check:dist": "node scripts/check.mjs --dist",
    "check:all": "node scripts/check.mjs --rasters",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "npm run check && npm run build && npm run check:dist && npm test",
    "verify:all": "npm run verify && npm run raster && npm run check:all"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/npm": "^12.0.0",
    "semantic-release": "^23.0.0",
    "sharp": "^0.35.5"
  },
  "license": "UNLICENSED"
}
